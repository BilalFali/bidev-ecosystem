# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use the service role key — it bypasses RLS so the worker can insert articles
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# UUID of the Supabase auth user that will own generated articles (your admin account)
# Find it in: Supabase dashboard → Authentication → Users → copy your user's ID
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Name of the tab inside the spreadsheet (default: Ideas)
GOOGLE_SHEET_NAME=Ideas

# Service account credentials JSON — paste the entire file content as a single line
# How to get: Google Cloud Console → IAM → Service Accounts → Create → Keys → JSON
# Then share the spreadsheet with the service account email
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expression for how often to check the sheet (default: every 30 minutes)
CRON_SCHEDULE=*/30 * * * *
